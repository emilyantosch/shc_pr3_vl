    typst compile --root ~/projects/projects/shc_pr3_vl/SOL2/ slides_3/main.typ slides_3/{{ datetime("%Y%m%d") }}_lab3_antosch_rev01.pdf
    typst compile --root ~/projects/projects/shc_pr3_vl/SOL2/ slides_4/main.typ slides_4/{{ datetime("%Y%m%d") }}_lab4_antosch_rev01.pdf
    typst compile --root ~/projects/projects/shc_pr3_vl/SOL2/ slides_5/main.typ slides_5/{{ datetime("%Y%m%d") }}_lab5_antosch_rev01.pdf
    typst compile --root ~/projects/projects/shc_pr3_vl/SOL2/ slides_6/main.typ slides_6/{{ datetime("%Y%m%d") }}_lab6_antosch_rev01.pdf
    typst compile --root ~/projects/projects/shc_pr3_vl/SOL2/ slides_7/main.typ slides_7/{{ datetime("%Y%m%d") }}_lab7_antosch_rev01.pdf
    typst compile --root ~/projects/projects/shc_pr3_vl/SOL2/ slides_8/main.typ slides_8/{{ datetime("%Y%m%d") }}_lab8_antosch_rev01.pdf
