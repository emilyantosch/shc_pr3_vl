# Justfile for compiling all Typst files in the project

# Compile all Typst files (labs, slides, and exams)
compile_all rev: (compile_labs rev) (compile_slides rev) (compile_exams rev)

# Compile digital and white-background print labs, with and without solutions
compile_labs rev:
    @for dir in labs/lab[1-4]; do \
        lab=$(basename "$dir"); \
        for medium in digital print; do \
            for solution in false true; do \
                suffix=""; [ "$solution" = false ] || suffix="_solution"; \
                output="$dir/{{ datetime("%Y%m%d") }}_${lab}_antosch${suffix}_${medium}_rev{{rev}}.pdf"; \
                echo "Compiling $output"; \
                typst compile --root . --input medium="$medium" --input solution="$solution" "$dir/main.typ" "$output" || exit; \
            done; \
        done; \
    done

# Compile all slide sets
compile_slides rev:
    @echo "Compiling slides..."
    @for number in $(seq 1 10); do \
        dir=$(printf 'slides_%03d' "$number"); \
        typst compile --root . "$dir/main.typ" "$dir/{{ datetime("%Y%m%d") }}_slides${number}_antosch_rev{{rev}}.pdf" || exit; \
    done

# Compile WS 2026/27 exams and separate solutions in both media
compile_exams rev="01":
    @for dir in exam_winter_2026 mock_exam_winter_2026; do \
        for medium in digital print; do \
            for solution in false true; do \
                suffix=""; [ "$solution" = false ] || suffix="_solution"; \
                output="$dir/{{ datetime("%Y%m%d") }}_${dir}_antosch${suffix}_${medium}_rev{{rev}}.pdf"; \
                echo "Compiling $output"; \
                typst compile --root . --input medium="$medium" --input solution="$solution" "$dir/main.typ" "$output" || exit; \
            done; \
        done; \
    done
