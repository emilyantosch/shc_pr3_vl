# Justfile for compiling all Typst files in the project

# Compile all Typst files (labs, slides, and exams)
compile_all: compile_labs compile_slides compile_exams

# Compile all lab exercises
compile_labs:
    @echo "Compiling lab exercises..."
    typst compile --root ~/projects/projects/shc_pr3_vl/SOL2/ labs/lab1/main.typ labs/lab1/{{ datetime("%Y%m%d") }}_lab1_antosch_rev01.pdf
    typst compile --root ~/projects/projects/shc_pr3_vl/SOL2/ labs/lab2/main.typ labs/lab2/{{ datetime("%Y%m%d") }}_lab2_antosch_rev01.pdf
    typst compile --root ~/projects/projects/shc_pr3_vl/SOL2/ labs/lab3/main.typ labs/lab3/{{ datetime("%Y%m%d") }}_lab3_antosch_rev01.pdf
    typst compile --root ~/projects/projects/shc_pr3_vl/SOL2/ labs/lab4/main.typ labs/lab4/{{ datetime("%Y%m%d") }}_lab4_antosch_rev01.pdf

# Compile all slide sets
compile_slides:
