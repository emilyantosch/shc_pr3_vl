---
import Arrow from './Arrow.astro';
interface Props { href: string; color?: 'blue' | 'green' | 'coral'; class?: string; }
const { href, color = 'blue', class: className = '' } = Astro.props;
---
<a href={href} class:list={['action', className]}>
  <span><slot /></span><span class:list={['action-dot', `dot-${color}`]}><Arrow /></span>
</a>
